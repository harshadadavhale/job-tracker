<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= job ? 'Edit Job' : 'Add Job' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

<nav class="navbar">
  <a href="/">⚡ JobTrack</a>
  <div>
    <a href="/jobs/dashboard">Dashboard</a>
    <a href="/auth/logout">Logout</a>
  </div>
</nav>

<div class="container">
  <div class="form-card">

    <h2><%= job ? 'Edit Application' : 'Add New Application' %></h2>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form action="<%= job ? '/jobs/edit/' + job._id : '/jobs/add' %>" method="POST">

      <div class="form-group">
        <label>Company Name</label>
        <input
          type="text"
          name="company"
          placeholder="e.g. Google, Infosys"
          value="<%= job ? job.company : '' %>"
          required
        />
      </div>

      <div class="form-group">
        <label>Job Role</label>
        <input
          type="text"
          name="role"
          placeholder="e.g. Backend Developer"
          value="<%= job ? job.role : '' %>"
          required
        />
      </div>

      <div class="form-group">
        <label>Status</label>
        <select name="status">
          <% ['Applied','Interview','Selected','Rejected'].forEach(s => { %>
            <option value="<%= s %>" <%= job && job.status === s ? 'selected' : '' %>>
              <%= s %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label>Date Applied</label>
        <input
          type="date"
          name="date"
          value="<%= job ? new Date(job.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>"
        />
      </div>

      <div class="form-group">
        <label>Notes (optional)</label>
        <textarea name="notes" rows="3" placeholder="Interview rounds, referral info..."><%= job ? job.notes : '' %></textarea>
      </div>

      <div class="form-actions">
        <a href="/jobs/dashboard" class="btn-cancel">Cancel</a>
        <button type="submit" class="btn-submit">
          <%= job ? 'Update Job' : 'Add Job' %>
        </button>
      </div>

    </form>
  </div>
</div>

</body>
</html>